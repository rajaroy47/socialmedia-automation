# ============================================
# SERVER
# ============================================
PORT=4000
# Publicly reachable URL for this server (used to build media links Zernio
# can fetch). While testing locally, use an ngrok/cloudflared tunnel URL.
BASE_URL=http://localhost:4000

# ============================================
# MONGODB
# ============================================
MONGO_URI=

# ============================================
# GEMINI (script + posting metadata generation)
# ============================================
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ============================================
# ELEVENLABS — add as many free-tier keys (one per email) as you have.
# The service tries key 1 first and automatically falls through to the
# next one whenever it hits a quota/rate-limit/auth error.
#
# IMPORTANT: voice IDs live *inside* an ElevenLabs account, so each key
# needs its OWN matching ELEVENLABS_VOICE_ID_<n> — a voice you cloned/picked
# under key 1's account will not exist under key 2's account. Every
# ELEVENLABS_API_KEY_<n> below must be paired with an ELEVENLABS_VOICE_ID_<n>
# on the same number. Whichever key ends up being used for a request, its
# matching voice ID is what gets sent to the API automatically.
# ============================================
ELEVENLABS_API_KEY_1=
ELEVENLABS_VOICE_ID_1=

ELEVENLABS_API_KEY_2=
ELEVENLABS_VOICE_ID_2=

ELEVENLABS_API_KEY_3=
ELEVENLABS_VOICE_ID_3=

ELEVENLABS_API_KEY_4=
ELEVENLABS_VOICE_ID_4=

ELEVENLABS_API_KEY_5=
ELEVENLABS_VOICE_ID_5=

ELEVENLABS_API_KEY_6=
ELEVENLABS_VOICE_ID_6=

ELEVENLABS_API_KEY_7=
ELEVENLABS_VOICE_ID_7=

ELEVENLABS_API_KEY_8=
ELEVENLABS_VOICE_ID_8=

ELEVENLABS_API_KEY_9=
ELEVENLABS_VOICE_ID_9=

ELEVENLABS_API_KEY_10=
ELEVENLABS_VOICE_ID_10=

# ============================================
# HUGGING FACE — same idea, up to 10 rotating keys.
# ============================================
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HUGGINGFACE_API_KEY_1=
HUGGINGFACE_API_KEY_2=
HUGGINGFACE_API_KEY_3=
HUGGINGFACE_API_KEY_4=
HUGGINGFACE_API_KEY_5=
HUGGINGFACE_API_KEY_6=
HUGGINGFACE_API_KEY_7=
HUGGINGFACE_API_KEY_8=
HUGGINGFACE_API_KEY_9=
HUGGINGFACE_API_KEY_10=

